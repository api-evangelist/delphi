{
  "opencollection": "1.0.0",
  "info": {
    "name": "Delphi Audience Clone API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Clone",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get clone profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.delphi.ai/v3/clone"
          },
          "docs": "Retrieve your clone's public profile information."
        }
      ]
    }
  ],
  "bundled": true
}