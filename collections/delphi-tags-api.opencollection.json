{
  "opencollection": "1.0.0",
  "info": {
    "name": "Delphi Audience Tags API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.delphi.ai/v3/tags"
          },
          "docs": "Retrieve all tags for your clone, sorted newest first."
        },
        {
          "info": {
            "name": "Create a tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.delphi.ai/v3/tags",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new tag for organizing your audience. Returns 409 if a tag with the same name already exists."
        },
        {
          "info": {
            "name": "Tag a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.delphi.ai/v3/users/:user_id/tags/:tag_name",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "tag_name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Apply a tag to a user in your audience. Idempotent — tagging a user who already has the tag succeeds without error."
        },
        {
          "info": {
            "name": "Untag a user",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.delphi.ai/v3/users/:user_id/tags/:tag_name",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "tag_name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove a tag from a user. Idempotent — untagging a user who doesn't have the tag succeeds without error."
        }
      ]
    }
  ],
  "bundled": true
}